# Copy to .env for local runs. Never commit a real .env file.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/finguard
# Used by the automated tests (a separate database that tests may fill with data).
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/finguard_test
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
